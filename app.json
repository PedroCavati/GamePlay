{
  "expo": {
    "name": "GamePlay",
    "slug": "GamePlay",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "gameplay",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.pedrocavati.GamePlay"
    },
    "android": {
      "predictiveBackGestureEnabled": false,
      "package": "com.pedrocavati.GamePlay"
    },
    "web": {
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0E1647",
          "image": "./assets/images/splash-icon.png"
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
